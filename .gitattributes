# 换行符规则：不同脚本类型要求相反，必须锁死，不能交给 core.autocrlf 自动处理
#
# 批处理脚本必须用 CRLF。若为 LF，Windows 双击会直接闪退（无报错、无输出）。
*.bat  text eol=crlf
*.cmd  text eol=crlf

# PowerShell 脚本用 CRLF 兼容性最好
*.ps1  text eol=crlf

# Shell 脚本必须用 LF。若为 CRLF，macOS / Linux 会报
#   /bin/bash^M: bad interpreter: No such file or directory
*.sh   text eol=lf

# 其他文本文件统一 LF
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.txt  text eol=lf
